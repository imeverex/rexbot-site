{
  "redirects": [
    {
      "source": "/:path((?!overlay/|requests\\.json|bot-healthz).*)",
      "has": [{ "type": "host", "value": "rexbot.everexmedia.ca" }],
      "destination": "https://rexbotapp.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/analytics.json", "destination": "https://rextwitchbot-production.up.railway.app/analytics.json" },
    { "source": "/discord/:path*", "destination": "https://rextwitchbot-production.up.railway.app/discord/:path*" },
    { "source": "/dashboard", "destination": "https://rextwitchbot-production.up.railway.app/dashboard" },
    { "source": "/commands", "destination": "https://rextwitchbot-production.up.railway.app/commands" },
    { "source": "/timers", "destination": "https://rextwitchbot-production.up.railway.app/timers" },
    { "source": "/settings", "destination": "https://rextwitchbot-production.up.railway.app/settings" },
    { "source": "/requests.json", "destination": "https://rextwitchbot-production.up.railway.app/requests.json" },
    { "source": "/bot-healthz", "destination": "https://rextwitchbot-production.up.railway.app/healthz" },
    { "source": "/twitch/:path*", "destination": "https://rextwitchbot-production.up.railway.app/twitch/:path*" },
    { "source": "/spotify/:path*", "destination": "https://rextwitchbot-production.up.railway.app/spotify/:path*" },
    { "source": "/overlay/:path*", "destination": "https://rextwitchbot-production.up.railway.app/overlay/:path*" },
    { "source": "/email/:path*", "destination": "https://rextwitchbot-production.up.railway.app/email/:path*" },
    { "source": "/commands/:path*", "destination": "https://rextwitchbot-production.up.railway.app/commands/:path*" },
    { "source": "/timers/:path*", "destination": "https://rextwitchbot-production.up.railway.app/timers/:path*" }
  ]
}

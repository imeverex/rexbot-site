{
  "functions": {
    "api/social.js": {
      "includeFiles": "api/_social/**"
    }
  },
  "redirects": [
    {
      "source": "/:path((?!overlay/|requests\\.json|bot-healthz).*)",
      "has": [
        {
          "type": "host",
          "value": "rexbot.everexmedia.ca"
        }
      ],
      "destination": "https://rexbotapp.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/editors", "destination": "https://rextwitchbot-production.up.railway.app/editors" },
    { "source": "/editors.json", "destination": "https://rextwitchbot-production.up.railway.app/editors.json" },
    { "source": "/editors/:path*", "destination": "https://rextwitchbot-production.up.railway.app/editors/:path*" },
    { "source": "/session/:path*", "destination": "https://rextwitchbot-production.up.railway.app/session/:path*" },
    { "source": "/bot/auth", "destination": "https://rextwitchbot-production.up.railway.app/bot/auth" },
    {
      "source": "/analytics.json",
      "destination": "https://rextwitchbot-production.up.railway.app/analytics.json"
    },
    {
      "source": "/discord/:path*",
      "destination": "https://rextwitchbot-production.up.railway.app/discord/:path*"
    },
    {
      "source": "/dashboard",
      "destination": "https://rextwitchbot-production.up.railway.app/dashboard"
    },
    {
      "source": "/commands",
      "destination": "https://rextwitchbot-production.up.railway.app/commands"
    },
    {
      "source": "/timers",
      "destination": "https://rextwitchbot-production.up.railway.app/timers"
    },
    {
      "source": "/settings",
      "destination": "https://rextwitchbot-production.up.railway.app/settings"
    },
    {
      "source": "/requests.json",
      "destination": "https://rextwitchbot-production.up.railway.app/requests.json"
    },
    {
      "source": "/bot-healthz",
      "destination": "https://rextwitchbot-production.up.railway.app/healthz"
    },
    {
      "source": "/twitch/:path*",
      "destination": "https://rextwitchbot-production.up.railway.app/twitch/:path*"
    },
    {
      "source": "/spotify/:path*",
      "destination": "https://rextwitchbot-production.up.railway.app/spotify/:path*"
    },
    {
      "source": "/overlay/:path*",
      "destination": "https://rextwitchbot-production.up.railway.app/overlay/:path*"
    },
    {
      "source": "/email/:path*",
      "destination": "https://rextwitchbot-production.up.railway.app/email/:path*"
    },
    {
      "source": "/commands/:path*",
      "destination": "https://rextwitchbot-production.up.railway.app/commands/:path*"
    },
    {
      "source": "/mod-activity/:path*",
      "destination": "https://rextwitchbot-production.up.railway.app/mod-activity/:path*"
    },
    {
      "source": "/raids/:path*",
      "destination": "https://rextwitchbot-production.up.railway.app/raids/:path*"
    },
    {
      "source": "/moderation/:path*",
      "destination": "https://rextwitchbot-production.up.railway.app/moderation/:path*"
    },
    {
      "source": "/setlist/:path*",
      "destination": "https://rextwitchbot-production.up.railway.app/setlist/:path*"
    },
    {
      "source": "/activity.json",
      "destination": "https://rextwitchbot-production.up.railway.app/activity.json"
    },
    {
      "source": "/timers/:path*",
      "destination": "https://rextwitchbot-production.up.railway.app/timers/:path*"
    }
  ]
}
